[Unit]
Description=Arcelik MQTT Bridge for Home Assistant
Documentation=https://github.com/saranli/arcelikmqtt
After=network.target
Wants=network.target

[Service]
Type=simple
User=saranli
Group=saranli
WorkingDirectory=/home/saranli/ArcelikConnect/node
Environment=NODE_ENV=production
ExecStart=/usr/bin/node index.js
Restart=always
RestartSec=10
TimeoutStopSec=20
KillMode=mixed

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=false
ReadWritePaths=/home/saranli/ArcelikConnect/node

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=arcelik-mqtt

[Install]
WantedBy=multi-user.target
